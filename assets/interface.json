    "interface_version": 2,
    "name": "MaaLBC",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 1106534022",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MaaLBC!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/NekoyashikiSuzu/MaaLBC",
    "version": "0.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "Steam端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "LimbusCompany",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "Global",
            "path": [
                "./resource"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "普通任务",
            "entry": "MyTask1"
        },
        {
            "name": "选项任务",
            "entry": "MyTask2",
            "option": [
                "任务选项1"
            ]
        },
        {
            "name": "参数任务",
            "entry": "MyTask3",
            "option": [
                "任务选项1"
            ],
            "pipeline_override": {}
        },
        {
            "name": "带Custom的任务",
            "entry": "MyTask4"
        },
